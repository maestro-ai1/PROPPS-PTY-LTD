# PROPPS PTY LTD - environment variables
# Copy this file to .env.local for local development, and set the same keys
# in the Vercel project's Environment Variables for production.

# Where order / contact / wholesale notifications are delivered.
NOTIFY_EMAIL=sales@proppsptyltd.com.au

# SMTP (nodemailer) - Zoho Mail. EMAIL_SERVER_PASSWORD is a Zoho app-specific password.
# Without these, emails are skipped gracefully and forms fall back to WhatsApp.
EMAIL_SERVER_HOST=smtp.zoho.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_SECURE=true
EMAIL_SERVER_USER=sales@proppsptyltd.com.au
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=sales@proppsptyltd.com.au

# Admin Reply Portal passcode (server-only - never expose as NEXT_PUBLIC_*).
# In production the portal stays locked until this is set.
ADMIN_PASSCODE=

# Upstash Redis (order/enquiry store for the Reply Portal). Vercel Storage
# integrations may instead set KV_REST_API_URL / KV_REST_API_TOKEN, which are also read.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=