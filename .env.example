# PROPPS PTY LTD — environment variables
# Copy this file to .env.local for local development, and set the same keys
# in the Vercel project's Environment Variables for production.

# SMTP (nodemailer) — order/enquiry email notifications.
# Without these, emails are skipped gracefully (sendMail() returns {sent:false}).
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_SECURE=true
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=orders@proppsptyltd.com.au

# Admin Reply Portal passcode (server-only — never expose as NEXT_PUBLIC_*).
ADMIN_PASSCODE=

# Upstash Redis (order/enquiry store for the Reply Portal).
# Falls back to an in-memory/local store when absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
